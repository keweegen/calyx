# Окружение — воспроизводится из requirements.txt
.venv/
__pycache__/
*.pyc

# --- Сторонние данные и код -------------------------------------------------
# Не редистрибутируем: у всего есть канонический источник. Подробности — DATA.md.
# Комментарии здесь только на отдельных строках: в .gitignore хвостовой
# комментарий частью шаблона, а не комментарием.

# Архивы Zenodo 10998457 (920 МБ), CC BY 4.0:
data/

# Клон philshiu/Drosophila_brain_model (370 МБ): MIT-код плюс коннектом FlyWire
# под CC BY-NC 4.0. Вендоринг распространил бы ограничение NC на весь репозиторий.
Drosophila_brain_model/

# --- Выходы прогонов --------------------------------------------------------
# Сырые спайки и логи: воспроизводимы, крупные, и по нашему прочтению наследуют
# CC BY-NC 4.0 от данных FlyWire как производный материал. Мелкие сводки
# (rate.csv, rate_std.csv, mn9.json, эталон) в git идут — они сюда не подпадают.
results/**/*.parquet
results/*.log
results/diag/

# --- Локальный мусор --------------------------------------------------------
*.tmp
*.part
.DS_Store
Thumbs.db
