# Environment — reproduced from requirements.txt
.venv/
__pycache__/
*.pyc

# --- Third-party data and code -----------------------------------------------
# Not redistributed: everything has a canonical source. Details — DATA.md.
# Comments here live on their own lines only: in .gitignore a trailing
# comment is part of the pattern, not a comment.

# Zenodo 10998457 archives (920 MB), CC BY 4.0:
data/

# Clone of philshiu/Drosophila_brain_model (370 MB): MIT code plus the FlyWire connectome
# under CC BY-NC 4.0. Vendoring it would spread the NC restriction over the whole repo.
Drosophila_brain_model/

# --- Run outputs --------------------------------------------------------
# Raw spikes and logs: reproducible, large, and by our reading inherit
# CC BY-NC 4.0 from the FlyWire data as derived material. The small summaries
# (rate.csv, rate_std.csv, mn9.json, the reference) go into git — they don't fall under this.
results/**/*.parquet
results/**/*.log
results/diag/

# Cache of compiled Cython inserts: reproduced by the compiler.
.cython_cache/

# --- Local clutter --------------------------------------------------------
*.tmp
*.part
.DS_Store
Thumbs.db

# V1b calibration shards - state for resuming a run; all their points
# are fully contained in the assembled calibration_stage*.json, which is versioned
results/v1b/calibration_stage*.shard*.json

# V1c stage shards - same idea: their points are fully contained in the assembled
# v1c_grid.json. Per-shard distance-to-threshold maps fall under the
# results/**/*.parquet rule above along with the assembled map.
results/v1c/v1c_grid.shard*.json
