# Явный бэкенд кодогенерации.
#
# При автовыборе Brian2 в каждом воркере пробует скомпилировать Cython. Если
# компиляция недоступна, он проваливается и пишет предупреждение через логгер;
# при десятке параллельных процессов пул loky встаёт в logging.emit (дедлок)
# либо воркер снимается операционной системой (TerminatedWorkerError). Явный
# target убирает и пробу компиляции, и поток предупреждений.
#
# Для target = 'cython' нужен рабочий компилятор. На Windows setuptools нередко
# не находит установленную Visual Studio; запуск через msvc_run.bat это решает.
# Замер обоих бэкендов — bench_backend.py. Смена target меняет конфиг прогона и
# требует перепрогона лестницы (README).
[codegen]
target = 'numpy'
