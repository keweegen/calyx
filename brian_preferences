# Explicit codegen backend.
#
# With auto-selection, Brian2 tries to compile Cython in every worker. If
# compilation is unavailable, it fails and writes a warning through the logger;
# with a dozen parallel processes the loky pool gets stuck in logging.emit (deadlock)
# or the worker gets killed by the operating system (TerminatedWorkerError). An explicit
# target removes both the compilation probe and the stream of warnings.
#
# For target = 'cython' a working compiler is required. On Windows, setuptools often
# fails to find an installed Visual Studio; running via msvc_run.bat solves this.
# Benchmark of both backends — bench_backend.py. Changing the target changes the run
# configuration and requires rerunning the ladder (README).
[codegen]
target = 'numpy'
