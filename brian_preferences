# Отключает автовыбор бэкенда кодогенерации.
#
# Причина: без MSVC каждый воркер brian2 при Synapses.connect заново пробует
# скомпилировать Cython, проваливается и пишет предупреждение через логгер.
# При 12 параллельных процессах loky пул встаёт в logging.emit (дедлок), либо
# воркер снимается операционной системой (TerminatedWorkerError).
#
# Явный target убирает и пробу компиляции, и поток предупреждений.
# Когда будут установлены Build Tools, поменять на 'cython' ради скорости.
[codegen]
target = 'numpy'
