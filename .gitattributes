# Frozen document copies are stored byte-for-byte: their SHA-256 is recorded in
# spec_sha256.txt as a pre-registration, and line-ending normalization would make
# the stored file differ from the one that was hashed.
results/**/*.frozen.md -text

# The same applies to the stand's configs and hash files: the config's SHA-256 is recorded in
# spec_sha256.txt alongside the spec's hash, so line-ending
# normalization would make the file checked out differ from the hashed one.
results/**/config_v1b*.json -text
results/**/spec_sha256.txt -text

# Stage 0 stamp of V1c (rule D1): its SHA-256 is recorded in stamp0_sha256.txt and
# proves the stage's construction predates the pre-hash measurements. Line-ending
# normalization would rob the proof of its force.
results/**/*.stamp0.md -text
results/**/stamp0_v1c.json -text
results/**/stamp0_sha256.txt -text

# V1c stage pre-registration: the byte-identical spec copy falls under the
# *.frozen.md rule above, hashes — under spec_sha256.txt. The stage config with the five
# canonical grid nodes and the detector table are hashed alongside
# the spec, so line-ending normalization is forbidden for them too.
results/**/config_v1c*.json -text
results/**/detector_table.json -text

# V1c stage run plan and its SHA-256: the plan is declared BEFORE the run starts and
# the report refers to it, so it is hashed alongside the config, and
# line-ending normalization would make the file checked out differ from the
# hashed one.
results/**/run_plan.json -text
results/**/run_plan_sha256.txt -text

# V1c outcome classification stamp from the literature: it declares the rule before the
# answer is obtained, its SHA-256 is recorded alongside, so line-ending
# normalization would make the file checked out differ from the hashed one.
results/**/kc_classification_stamp.json -text
results/**/kc_classification_stamp_sha256.txt -text

# Revision v0.12 release gate: the conditions are declared before the checks,
# the hash is recorded alongside, so line-ending normalization is forbidden for it.
results/**/release_gate_v012.json -text
results/**/release_gate_v012_sha256.txt -text

# Russian document originals are stored byte-for-byte: their SHA-256 is recorded in
# docs/ru/sha256.txt, and line-ending normalization would make the stored file
# differ from the one that was hashed.
docs/ru/*.ru.md -text
