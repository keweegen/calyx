# Замороженные копии документов хранятся побайтово: их SHA-256 записан в
# spec_sha256.txt как предрегистрация, и нормализация переводов строки сделала
# бы хранимый файл отличным от того, который хэшировался.
results/**/*.frozen.md -text

# То же относится к конфигам стенда и файлам хэшей: SHA-256 конфига записан в
# spec_sha256.txt наравне с хэшем спецификации, поэтому нормализация переводов
# строки сделала бы выданный на checkout файл отличным от хэшированного.
results/**/config_v1b*.json -text
results/**/spec_sha256.txt -text

# Штамп 0 ступени V1c (правило Д1): его SHA-256 записан в stamp0_sha256.txt и
# доказывает, что конструкция ступени старше до-хэшевых измерений. Нормализация
# переводов строки лишила бы доказательство силы.
results/**/*.stamp0.md -text
results/**/stamp0_v1c.json -text
results/**/stamp0_sha256.txt -text

# Предрегистрация ступени V1c: байтовая копия спецификации подпадает под
# правило *.frozen.md выше, хэши - под spec_sha256.txt. Конфиг ступени с пятью
# каноническими узлами сетки и таблица детекторов хэшируются наравне с
# спецификацией, поэтому нормализация переводов строки им тоже запрещена.
results/**/config_v1c*.json -text
results/**/detector_table.json -text
